{
  "name": "desktop-companion",
  "version": "0.1.0",
  "private": true,
  "description": "바탕화면 키우기 — pixel desktop companion (Phase 0 prototype)",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "server": "node server/index.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "bio.beaubrain.desktopcompanion",
    "productName": "Desktop Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "extraResources": [
        {
          "from": "build/mac-watcher",
          "to": "mac-watcher"
        }
      ]
    },
    "dmg": {
      "sign": false
    }
  }
}
