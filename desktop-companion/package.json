{
  "name": "desktop-companion",
  "version": "0.1.0",
  "private": true,
  "description": "바탕화면 키우기 — pixel desktop companion (Phase 0 prototype)",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
